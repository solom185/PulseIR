<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- Explicit allowlist: backs up only user data & preferences; read-only catalog DB is excluded automatically -->
    <cloud-backup>
        <include domain="file" path="pulseir_user_data.json" />
        <include domain="sharedpref" path="pulseir_prefs.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="pulseir_user_data.json" />
        <include domain="sharedpref" path="pulseir_prefs.xml" />
    </device-transfer>
</data-extraction-rules>